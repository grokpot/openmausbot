+export function parseSidebarAttentionSort(value: string | null): boolean {
+  // Absent means on: Grok-style discovery is the default. Only an explicit "false" turns it off.
+  return value !== "false";
+}
+
+let sessionSidebarAttentionSort: boolean | undefined;
+const sidebarAttentionSortListeners = new Set<() => void>();
+
+function notifySidebarAttentionSort(): void {
+  for (const listener of sidebarAttentionSortListeners) listener();
+}
+
+function onSidebarAttentionSortStorage(event: StorageEvent): void {
+  if (event.key !== SIDEBAR_ATTENTION_SORT_KEY && event.key !== null) return;
+  sessionSidebarAttentionSort = undefined;
+  notifySidebarAttentionSort();
+}
+
+export function subscribeSidebarAttentionSort(listener: () => void): () => void {
+  sidebarAttentionSortListeners.add(listener);
+  if (
+    sidebarAttentionSortListeners.size === 1 &&
+    typeof window !== "undefined" &&
+    typeof window.addEventListener === "function"
+  ) {
+    window.addEventListener("storage", onSidebarAttentionSortStorage);
+  }
+  return () => {
+    sidebarAttentionSortListeners.delete(listener);
+    if (
+      sidebarAttentionSortListeners.size === 0 &&
+      typeof window !== "undefined" &&
+      typeof window.removeEventListener === "function"
+    ) {
+      window.removeEventListener("storage", onSidebarAttentionSortStorage);
+    }
+  };
+}
+
+export function loadSidebarAttentionSort(storage?: Pick<Storage, "getItem"> | null): boolean {
+  if (storage === undefined && sessionSidebarAttentionSort !== undefined) return sessionSidebarAttentionSort;
+  try {
+    const target = storage === undefined ? (globalThis.localStorage ?? null) : storage;
+    return parseSidebarAttentionSort(target?.getItem(SIDEBAR_ATTENTION_SORT_KEY) ?? null);
+  } catch {
+    return true;
+  }
+}
+
+export function saveSidebarAttentionSort(
+  enabled: boolean,
+  storage?: Pick<Storage, "setItem"> | null,
+): void {
+  try {
+    const target = storage === undefined ? (globalThis.localStorage ?? null) : storage;
+    target?.setItem(SIDEBAR_ATTENTION_SORT_KEY, enabled ? "true" : "false");
+  } catch {
+  }
+}
+
+export function setSidebarAttentionSort(enabled: boolean): void {
+  sessionSidebarAttentionSort = enabled;
+  saveSidebarAttentionSort(enabled);
+  notifySidebarAttentionSort();
+}
+
+export function useSidebarAttentionSort(): boolean {
+  return useSyncExternalStore(subscribeSidebarAttentionSort, loadSidebarAttentionSort, () => true);
+}
+
 
