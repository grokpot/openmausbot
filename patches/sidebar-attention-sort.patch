diff --git a/src/lib/sidebar-layout.ts b/src/lib/sidebar-layout.ts
index e49caee9b..90976d3e3 100644
--- a/src/lib/sidebar-layout.ts
+++ b/src/lib/sidebar-layout.ts
@@ -151,6 +151,50 @@ export function activeBotsFirst<T>(parts: { pinnedBots: T[]; sectionedBots: T[];
   return { pinnedBots: first(parts.pinnedBots), sectionedBots: first(parts.sectionedBots), unsectionedBots: first(parts.unsectionedBots) };
 }
 
+/** Newest activity on a bot's live conversations (not routine runs or archived threads). */
+export function botSidebarRecency(bot: {
+  tasks?: ReadonlyArray<{ updatedAt?: number; createdAt?: number; routineRunId?: string; archivedAt?: number }> | null;
+}): number {
+  let newest = 0;
+  for (const task of bot.tasks ?? []) {
+    if (task.routineRunId || task.archivedAt !== undefined) continue;
+    const at = typeof task.updatedAt === "number" && Number.isFinite(task.updatedAt)
+      ? task.updatedAt
+      : typeof task.createdAt === "number" && Number.isFinite(task.createdAt)
+        ? task.createdAt
+        : 0;
+    if (at > newest) newest = at;
+  }
+  return newest;
+}
+
+/**
+ * Grok-style sidebar order inside each list (main bots, each department): waiting-on-you, then unread,
+ * then the rest. Waiting and unread groups are newest-first; everyone else keeps the person's saved
+ * order so a read bot drops back into place. Pinned rows keep their pin order unless `reorderPinned`.
+ */
+export function attentionBotsFirst<T>(
+  parts: { pinnedBots: T[]; sectionedBots: T[]; unsectionedBots: T[] },
+  rank: (bot: T) => number,
+  recency: (bot: T) => number,
+  options?: { reorderPinned?: boolean },
+) {
+  const sortList = (bots: T[]) => bots
+    .map((bot, index) => ({ bot, index, tier: rank(bot), at: recency(bot) }))
+    .sort((left, right) => {
+      if (left.tier !== right.tier) return left.tier - right.tier;
+      // Newest first only while the bot still needs attention; the quiet list keeps saved order.
+      if (left.tier < 2 && right.tier < 2 && left.at !== right.at) return right.at - left.at;
+      return left.index - right.index;
+    })
+    .map((entry) => entry.bot);
+  return {
+    pinnedBots: options?.reorderPinned ? sortList(parts.pinnedBots) : parts.pinnedBots,
+    sectionedBots: sortList(parts.sectionedBots),
+    unsectionedBots: sortList(parts.unsectionedBots),
+  };
+}
+
