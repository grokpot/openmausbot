+/** When on (default): bots waiting on you / with unread float to the top by newest response; Inbox row stays hidden. */
+export const SIDEBAR_ATTENTION_SORT_KEY = "openmausbot.sidebarAttentionSort.v1";
 
 /** What the sidebar's key keeps for the column of avatars. The values an older app kept there ("compact", "icons") open
  * the sidebar as it is. */
